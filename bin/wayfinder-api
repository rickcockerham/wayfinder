#!/usr/bin/env ruby
require "json"
require "net/http"
require "openssl"

# Keep the reusable credential outside the checkout and out of process arguments.
config_path = File.expand_path(ENV.fetch("WAYFINDER_API_CONFIG", "~/.config/wayfinder/api.json"))
usage = "Usage: bin/wayfinder-api [get|post|patch|put|delete] [/api/items[/ID][?query]] [payload.json|-]"
method = ARGV.fetch(0, "get").downcase
path = ARGV.fetch(1, "/api/items")
request_classes = { "get" => Net::HTTP::Get, "post" => Net::HTTP::Post, "patch" => Net::HTTP::Patch, "put" => Net::HTTP::Put, "delete" => Net::HTTP::Delete }
abort usage unless request_classes.key?(method) && ARGV.length <= 3
abort "Only relative /api/items endpoints are supported" unless path.match?(%r{\A/api/items(?:/[1-9]\d*)?(?:\?[^\s#]*)?\z})
writing = %w[post patch put].include?(method)
abort usage if writing != (ARGV.length == 3)

# Refuse readable-by-others files and malformed credentials before contacting the server.
begin
  stat = File.stat(config_path)
  abort "API config must be a private regular file owned by this user: #{config_path}" unless stat.file? && stat.uid == Process.uid && (stat.mode & 0o077).zero?
  config = JSON.parse(File.read(config_path))
  abort "API config is invalid: #{config_path}" unless config.is_a?(Hash)
  token = config.fetch("token")
  abort "API config has an invalid token" unless token.is_a?(String) && token.match?(/\A[0-9a-f]{64}\z/)
rescue Errno::ENOENT, Errno::EACCES
  abort "Cannot read API config: #{config_path}"
rescue JSON::ParserError, KeyError, TypeError
  abort "API config is invalid: #{config_path}"
end

# Send credentials only to the intended HTTPS origin and never follow redirects.
http = Net::HTTP.new("mywayfinder.app", 443)
http.use_ssl = true
http.verify_mode = OpenSSL::SSL::VERIFY_PEER
http.open_timeout = 10
http.read_timeout = 30
request = request_classes.fetch(method).new(path)
request["Authorization"] = "Bearer #{token}"
request["Accept"] = "application/json"

# Writes take a JSON file or stdin, avoiding long commands and shell quoting of payloads.
if writing
  begin
    payload = ARGV[2] == "-" ? $stdin.read : File.read(ARGV[2])
    request.body = JSON.generate(JSON.parse(payload))
    request["Content-Type"] = "application/json"
  rescue JSON::ParserError, Errno::ENOENT, Errno::EACCES
    abort "Cannot read a valid JSON payload"
  end
end

# Show API data without printing credentials, cookies or request headers.
begin
  response = http.request(request)
  begin
    puts JSON.pretty_generate(JSON.parse(response.body)) unless response.body.to_s.empty?
  rescue JSON::ParserError
    warn "API returned a non-JSON response (HTTP #{response.code})"
  end
  abort "API request failed (HTTP #{response.code})" unless response.is_a?(Net::HTTPSuccess)
rescue Timeout::Error, SocketError, SystemCallError, OpenSSL::SSL::SSLError
  abort "Could not connect securely to the Wayfinder API"
end
